            },
            "url": {
              "raw": "{{baseUrl}}/api/driver/orders/{{order_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "driver", "orders", "{{order_id}}", "status"]
            }
          }
        }
      ]
    },
