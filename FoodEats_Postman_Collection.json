    {
      "name": "2. Merchants & Catalog",
      "item": [
        {
          "name": "Get All Merchants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants"]
            }
          }
        },
        {
          "name": "Get Merchant by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants", "1"]
            }
          }
        },
        {
          "name": "Get Categories by Merchant ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories?merchantId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"],
              "query": [
                {
                  "key": "merchantId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Menu Items by Merchant ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?merchantId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"],
              "query": [
                {
                  "key": "merchantId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Search Menu Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/search?q=burger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "burger"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer Orders & Cart",
      "item": [
        {
          "name": "Place New Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order placed successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"order_id\", jsonData.id);",
                  "    console.log(\"Created new order ID: \" + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": 1,\n  \"deliveryAddress\": \"Building 42, St. 302, BKK1, Phnom Penh\",\n  \"deliveryFee\": 1.50,\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"itemName\": \"Double Truffle Smash Burger\",\n      \"price\": 7.25,\n      \"quantity\": 2,\n      \"selectedOptions\": \"Patty Size: Double 150g\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Customer Order History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{order_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Merchant Kitchen Pipeline",
      "item": [
        {
          "name": "Get Store Order Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchant_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?merchantId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "merchantId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Merchant Accept Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{merchant_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        },
        {
          "name": "Merchant Start Cooking (PREPARING)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{merchant_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PREPARING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        },
        {
          "name": "Merchant Ready for Pickup (READY_FOR_PICKUP)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{merchant_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"READY_FOR_PICKUP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        }
      ]
    },
