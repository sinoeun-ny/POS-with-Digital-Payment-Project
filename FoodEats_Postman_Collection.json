        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+85512999888\",\n  \"role\": \"CUSTOMER\",\n  \"address\": \"St 51, BKK1, Phnom Penh\"\n}"
            },
            "url": {
